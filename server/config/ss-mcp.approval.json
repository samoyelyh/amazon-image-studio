                    "searchVolume",
                    "searchesRank",
                    "trafficShare",
                    "trafficWordTypes",
                    "purchases",
                    "purchaseRate",
                    "clicks",
                    "impressions",
                    "products",
                    "supplyDemandRatio",
                    "bid",
                    "ppc",
                    "avgPrice",
                    "avgRating",
                    "avgReviews",
                    "titleDensity",
                    "spr",
                    "monopolyClickRate",
                    "adProducts",
                    "updatedTime",
                    "bestRank",
                    "bestAdRank",
                    "matchedAsins",
                    "clickShareRate",
                    "conversionShareRate"
                  ]
                },
                "minItems": 1,
                "maxItems": 26,
                "uniqueItems": true
              }
            }
          },
          "permissions": [
            "jobs.read"
          ],
          "risk": "read_only",
          "may_charge": true,
          "max_charge_units": 1,
          "keywords": [
            "ASIN",
            "关键词",
            "搜索",
            "流量"
          ]
