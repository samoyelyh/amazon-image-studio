                  "max": {
                    "type": "integer",
                    "description": "最大值。"
                  }
                },
                "additionalProperties": false
              },
              "bsr": {
                "type": "object",
                "description": "BSR 排名区间。",
                "properties": {
                  "min": {
                    "type": "integer",
                    "description": "最小值。"
