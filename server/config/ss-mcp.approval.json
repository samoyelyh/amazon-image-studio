              "sellers": {
                "type": "object",
                "description": "跟卖卖家数区间；仅用于过滤，不表示输出字段。",
                "properties": {
                  "min": {
                    "type": "integer",
                    "description": "最小值。"
                  },
                  "max": {
                    "type": "integer",
                    "description": "最大值。"
                  }
                },
                "additionalProperties": false
