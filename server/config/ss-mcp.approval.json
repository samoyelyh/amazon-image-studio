                "minItems": 1,
                "maxItems": 10
              },
              "dataRange": {
                "type": "string",
                "description": "时间范围。LAST_30_DAYS=滚动近30天（默认）；MONTH=归档自然月快照。LAST_30_DAYS 禁止传 month；MONTH 可不传 month（返回最新归档月），或传 yyyyMM 指定归档月。不要用 month 表达近30天。",
                "enum": [
                  "LAST_30_DAYS",
                  "MONTH"
                ],
                "default": "LAST_30_DAYS"
              },
              "month": {
                "type": "string",
                "description": "dataRange=MONTH 时使用的归档月份，格式 yyyyMM。dataRange=MONTH 且不传 month 时返回最新归档月；dataRange=LAST_30_DAYS 时禁止传。不要根据当前日期主动推断 month。",
                "pattern": "^\\d{6}$"
              },
              "trafficWordType": {
                "type": "array",
                "description": "流量词类型过滤。参数名固定为 trafficWordType（单数是历史命名），值必须是字符串数组，例如 [\"ORGANIC\",\"ADS\"]；数组内多值 OR。不传表示不过滤；只影响 items，不影响 summary.typeStats。不要传 trafficWordTypes。",
                "items": {
                  "type": "string",
