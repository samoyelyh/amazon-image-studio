              "orderDesc": {
                "type": "boolean",
                "description": "是否降序；入参是 orderDesc，不是 desc。不传时 true。"
              },
              "page": {
                "type": "object",
                "description": "分页窗口；每次调用只返回当前页。返回的 hasMore/nextCursor 仅表示可继续分页；仅当用户明确要求继续翻页、获取全量、导出数据，或用户明确指定的条数超过当前页时才继续调用。",
                "properties": {
