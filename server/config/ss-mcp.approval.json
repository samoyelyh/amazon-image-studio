                    "ORGANIC",
                    "ADS",
                    "AMAZON_CHOICE",
                    "EDITORIAL_RECOMMENDATION",
                    "FOUR_STAR",
                    "HIGHLY_RATED",
                    "SPONSOR_BRAND",
                    "SPONSOR_VIDEO",
                    "PRIMARY",
                    "PRECISE",
                    "PRECISE_LONG_TAIL",
                    "EFFECTIVE",
                    "CONVERSION_EXCELLENT",
                    "CONVERSION_STABLE",
                    "CONVERSION_LOST",
                    "INVALID"
                  ]
                },
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true
              },
              "orderField": {
                "enum": [
                  "searches",
                  "trafficShare"
                ],
                "type": "string",
                "description": "items 排序字段：searches=月搜索量估算；trafficShare=关键词在整组 ASIN 流量中的占比。不传时按下游预估周搜索量排序，注意默认排序与 searches 的月度口径不同。"
