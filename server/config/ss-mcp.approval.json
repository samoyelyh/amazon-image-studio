        {
          "name": "asin.detail",
          "description": "商品详情查询",
          "input_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "description": "按 ASIN 集合查询基础详情，支持批量（最多 20 个）。 optional 字段未指定时省略，由服务端承担默认值。",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "marketplace",
              "asins"
            ],
            "properties": {
              "asins": {
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "description": "待查询的 ASIN 列表，1～20 个。",
                "type": "array",
                "items": {
                  "pattern": "^B[0-9A-Z]{9}$",
                  "type": "string"
                }
              },
              "marketplace": {
                "description": "站点代码。",
                "type": "string",
                "enum": [
                  "DE",
                  "AE",
                  "IN",
                  "JP",
                  "IT",
                  "MX",
                  "FR",
                  "ES",
                  "SA",
                  "BR",
                  "AU",
                  "UK",
                  "US",
                  "CA"
                ]
              },
              "includeFields": {
                "maxItems": 20,
                "uniqueItems": true,
                "description": "同成本输出字段裁剪；不传或为空时返回默认字段集。",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "asin",
                    "marketplace",
                    "title",
                    "brand",
                    "categoryId",
                    "categoryPath",
                    "price",
                    "currency",
                    "rating",
                    "reviewCount",
                    "totalReview",
                    "bsr",
                    "seller",
                    "fulfillment",
                    "parentAsin",
                    "dimensions",
                    "weight",
                    "availableDate",
                    "recordUpdatedAt",
                    "variationList"
                  ]
                }
              }
            }
          },
          "permissions": [
            "jobs.read"
          ],
          "risk": "read_only",
          "may_charge": true,
          "max_charge_units": 1,
          "keywords": [
            "ASIN",
            "详情",
            "商品",
            "竞品"
          ]
        },
