              },
              "launchDateTo": {
                "type": "string",
                "description": "上架结束日期，格式 yyyy-MM-dd；仅用于过滤，不表示输出字段。"
              },
              "firstReviewDateFrom": {
                "type": "string",
                "description": "首评开始日期，格式 yyyy-MM-dd；仅用于过滤，不表示输出字段。"
              },
              "firstReviewDateTo": {
                "type": "string",
                "description": "首评结束日期，格式 yyyy-MM-dd；仅用于过滤，不表示输出字段。"
              },
              "productTags": {
                "type": "array",
                "description": "商品标签过滤；仅用于过滤，不表示输出字段。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "mainImage": {
                "type": "boolean",
                "description": "是否有主图视频/主图标记过滤；仅用于过滤，不表示输出字段。"
              },
              "bestSellingVariant": {
                "type": "boolean",
                "description": "畅销变体筛选：true 只返回每个父体下的畅销代表变体（销量最大的变体）；false 排除代表变体；不传时查询全部行（旧行为）。传入 asins 时忽略此参数，保证集合内所有 ASIN 都返回。"
              },
              "fulfillment": {
                "description": "履约方式过滤。",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "FBA",
                    "FBM"
                  ]
                },
                "type": "array"
              },
              "sellerNation": {
                "type": "array",
                "description": "按卖家所属地过滤（国家/地区编码）。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "sellerType": {
                "description": "卖家类型过滤；仅用于过滤，输出字段为 fulfillment。",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "AMAZON",
                    "THIRD_PARTY"
                  ]
                },
                "type": "array"
              },
              "page": {
                "properties": {
                  "cursor": {
                    "type": "integer",
                    "description": "offset 起点，默认 0。最大 2000，与下游 startIndex 上限一致；超过表示结果被截断，不代表名单已经取完。",
                    "minimum": 0,
                    "maximum": 2000
                  },
                  "size": {
                    "type": "integer",
                    "description": "每页条数，默认 100。",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "description": "分页窗口；每次调用只返回当前页。返回的 hasMore/nextCursor 仅表示可继续分页；仅当用户明确要求继续翻页、获取全量、导出数据，或用户明确指定的条数超过当前页时才继续调用。",
                "additionalProperties": false,
                "type": "object"
              },
              "orderField": {
                "enum": [
                  "total_amount",
                  "total_units",
                  "impression",
                  "conversion_rate"
                ],
                "type": "string",
                "description": "排序字段。支持: total_amount(销售额), total_units(销量), impression(曝光), conversion_rate(转化率)。默认 total_amount 降序。"
              },
              "desc": {
                "type": "boolean",
                "description": "是否降序。默认 true。"
              },
              "includeFields": {
                "items": {
                  "type": "string",
                  "enum": [
                    "asin",
                    "title",
                    "brand",
                    "price",
                    "currency",
                    "bsr",
                    "rating",
                    "monthlyReviewCount",
                    "childReviewCount",
                    "monthlySales",
                    "monthlySalesScope",
                    "monthlyRevenue",
                    "fulfillment",
                    "sellerName",
                    "sellerNation",
                    "badges",
                    "amzUnit",
                    "variations",
                    "lqs",
                    "profit",
                    "fba",
                    "questions",
                    "coupon",
                    "parent",
                    "bestSellingVariant",
                    "availableDate"
                  ]
                },
                "maxItems": 26,
                "description": "仅控制输出字段，不能传过滤字段。asin 始终返回，用于对应结果行。不传或为空时默认返回 asin/title/brand/price/currency/bsr/rating/monthlyReviewCount/monthlySales/monthlyRevenue/fulfillment/sellerName/sellerNation/badges/parent/bestSellingVariant/availableDate；childReviewCount 与 amzUnit/variations/lqs/profit/fba/questions/coupon 需显式传入。完整可选值以 items.enum 为准。",
                "type": "array",
                "uniqueItems": true
              }
            }
          },
          "permissions": [
            "jobs.read"
          ],
          "risk": "read_only",
          "may_charge": true,
          "max_charge_units": 1,
          "keywords": [
            "ASIN",
