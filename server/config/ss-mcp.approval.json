      "tools": [
        {
          "name": "asin.list",
          "description": "商品和竞品列表查询",
          "input_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "description": "查询 ASIN 商品列表，支持关键词、ASIN 集合、类目与各类筛选条件。品牌过滤仅支持 brandInclude / brandExclude；keyword/asins/categoryId/brandInclude 至少提供一个查询锚点。 optional 字段未指定时省略，由服务端承担默认值。",
            "required": [
              "marketplace"
            ],
            "additionalProperties": false,
            "properties": {
              "marketplace": {
                "type": "string",
                "description": "站点代码。",
                "enum": [
                  "AE",
                  "AU",
                  "BR",
                  "CA",
                  "DE",
                  "ES",
                  "FR",
                  "IN",
                  "IT",
                  "JP",
                  "MX",
                  "SA",
                  "UK",
                  "US"
                ]
              },
              "keyword": {
                "type": "string",
                "description": "商品标题关键词。"
              },
              "asins": {
                "type": "array",
                "description": "按 ASIN 集合过滤；最多 40 个。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 40
              },
              "categoryId": {
                "type": "string",
                "description": "类目节点 ID。"
              },
              "categoryIdExact": {
                "type": "boolean",
                "description": "true 表示只查当前类目；缺省包含子类目。"
              },
              "dataMonth": {
                "type": "string",
                "description": "数据归档月份，格式 yyyyMM。不传时使用近 30 天数据；显式传入时必须是可用历史月份，不可用或晚于最新归档月会直接报错，不会回退近 30 天。响应中的 dataMode / dataMonth 表示实际数据口径。",
                "pattern": "^\\d{6}$"
              },
              "brandInclude": {
                "type": "array",
                "description": "按品牌包含过滤。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "brandExclude": {
                "type": "array",
                "description": "按品牌排除过滤。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "sellerInclude": {
                "type": "array",
                "description": "按卖家包含过滤。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "sellerExclude": {
                "type": "array",
                "description": "按卖家排除过滤。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "excludeKeywords": {
                "type": "array",
                "description": "排除标题关键词过滤。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "excludeAsins": {
                "type": "array",
                "description": "排除 ASIN 过滤。",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "searchType": {
                "enum": [
                  "ASIN",
                  "TITLE",
                  "BRAND",
                  "SELLER"
                ],
                "type": "string",
                "description": "关键词匹配字段，缺省 TITLE。"
              },
              "price": {
                "type": "object",
                "description": "价格区间。",
                "properties": {
                  "min": {
                    "type": "number",
                    "description": "最小值。"
                  },
                  "max": {
                    "type": "number",
                    "description": "最大值。"
                  }
                },
                "additionalProperties": false
              },
              "sales": {
                "type": "object",
                "description": "月销量区间（父体/月度表口径，非 Amazon 公布子体销量）；仅用于过滤，输出字段为 monthlySales。",
                "properties": {
                  "min": {
                    "type": "integer",
                    "description": "最小值。"
                  },
                  "max": {
                    "type": "integer",
                    "description": "最大值。"
                  }
                },
                "additionalProperties": false
              },
              "revenue": {
                "type": "object",
                "description": "月销售额区间；仅用于过滤，输出字段为 monthlyRevenue。",
                "properties": {
                  "min": {
                    "type": "number",
                    "description": "最小值。"
                  },
                  "max": {
                    "type": "number",
                    "description": "最大值。"
                  }
                },
                "additionalProperties": false
              },
              "rating": {
                "type": "object",
                "description": "评分区间。",
                "properties": {
                  "min": {
                    "type": "number",
                    "description": "最小值。"
                  },
                  "max": {
                    "type": "number",
                    "description": "最大值。"
                  }
                },
                "additionalProperties": false
              },
              "monthlyReviewCount": {
                "type": "object",
                "description": "月度表同步评论数区间；过滤 monthlyReviewCount，不影响 childReviewCount。",
                "properties": {
