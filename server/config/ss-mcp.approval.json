              },
              "includeFields": {
                "type": "array",
                "description": "items 输出字段裁剪。不传或为空时返回默认字段集；只影响 items，不影响 summary 和 page。只传调用方需要的字段。",
                "items": {
                  "type": "string",
                  "enum": [
