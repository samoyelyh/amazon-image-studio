APP_NAME=Amazon Image Studio API
APP_VERSION=0.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:18080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=amazon_image_studio
MYSQL_USER=amazon
MYSQL_PASSWORD=replace-with-a-strong-password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2

S3_ENDPOINT_URL=http://127.0.0.1:19000
# Optional legacy presigning endpoint. The platform UI uses the authenticated
# same-origin /api/v1/assets/{asset_id}/content route, so leave this blank.
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-a-strong-password
S3_BUCKET=amazon-image-studio
S3_SECURE=false
S3_PRESIGNED_URL_TTL_SECONDS=900
ASSET_MAX_UPLOAD_BYTES=20971520
GENERATED_ASSET_MAX_BYTES=104857600
ASSET_MAX_IMAGE_PIXELS=40000000
ASSET_MAX_IMAGE_DIMENSION=12000
PROJECT_MAX_DRAFT_BYTES=1048576

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=amazon-image-studio
JWT_AUDIENCE=amazon-image-studio-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=ais_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Optional. If omitted, only RBAC definitions are synchronized.
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ORGANIZATION_NAME=Default Organization
BOOTSTRAP_QUOTA_BALANCE=10000
QUOTA_RESERVATION_TTL_MINUTES=60
API_KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RESOURCE_LEASE_TTL_SECONDS=300
RESOURCE_KEY_COOLDOWN_SECONDS=10
RESOURCE_KEY_COOLDOWN_MAX_SECONDS=10
PROVIDER_CONNECT_TIMEOUT_SECONDS=15
PROVIDER_REQUEST_TIMEOUT_SECONDS=480
PROVIDER_OUTPUT_MAX_BYTES=26214400
JOB_TIMEOUT_SECONDS=900
JOB_HEARTBEAT_TIMEOUT_SECONDS=180
JOB_DISPATCH_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
CELERY_WORKER_CONCURRENCY=10
JOB_SYSTEM_MAX_CONCURRENCY=10
JOB_ORGANIZATION_MAX_CONCURRENCY=10
JOB_USER_MAX_CONCURRENCY=10

# Optional AI control plane; requires the 0063 migration and explicit checkpoint setup.
AGENT_CONTROL_ENABLED=false
AGENT_CONTROL_WRITES_ENABLED=false
AGENT_CONTROL_MODEL_CALLS_ENABLED=false
AGENT_CONTROL_PLANNER=mock
# Optional Agent-only model pin; requires an approved keyed listing.plan binding.
# AGENT_CONTROL_TEXT_MODEL=gpt-6.1-sol
AGENT_DYNAMIC_CAPABILITIES_ENABLED=true
# Human-send consent, bounded per Run. Existing clients without auto_execute keep confirmation.
AGENT_AUTO_EXECUTE_ENABLED=false
# New human chat requests are autonomous only when the existing execution/model/write switches are enabled.
AGENT_EXECUTION_MODE=autonomous
AGENT_AUTONOMOUS_MAX_STEPS=12
# Legacy bounded v1 thresholds; not fee-approval gates in autonomous mode.
AGENT_AUTO_MAX_IMAGES=3
AGENT_AUTO_MAX_SECONDS=300
AGENT_AUTO_MAX_CREDITS=50
AGENT_AUTO_MAX_TEXT_JOBS=2
AGENT_AUTO_MAX_STEPS=4
AGENT_AUTO_MAX_ACTIVE_RUNS=3
AGENT_AUTO_SUBMISSIONS_PER_MINUTE=6
AGENT_AUTO_CREDITS_PER_HOUR=300
# Optional server-owned approval manifest; paths in it are relative to its directory.
# Never point this to a user-uploaded JSON file. No MCP servers are enabled by default.
# AGENT_CAPABILITY_MANIFEST=/app/config/agent-capabilities.json
AGENT_CAPABILITY_MAX_STEPS=8
AGENT_CAPABILITY_MAX_REPLANS=2
# Use a dedicated checkpoint schema/account; never run Saver.setup() in API startup.
# AGENT_CHECKPOINT_URL=mysql+asyncmy://checkpoint_user:CHANGE_ME@mysql:3306/agent_checkpoints
