APP_NAME=Amazon Image Studio API
APP_VERSION=0.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:18080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=amazon_image_studio
MYSQL_USER=amazon
MYSQL_PASSWORD=replace-with-a-strong-password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2

S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-a-strong-password
S3_BUCKET=amazon-image-studio
S3_SECURE=false
S3_PRESIGNED_URL_TTL_SECONDS=900
