# standalone: browser-local API settings, IndexedDB history and local batch queue
# multiuser: server-side auth, tasks, quota and assets (implemented in later phases)
VITE_DEPLOYMENT_MODE=standalone

# Required only by the future multiuser backend integration.
VITE_API_BASE_URL=http://127.0.0.1:18000/api/v1

# Docker Compose host ports. Defaults avoid common local 3306/8000 conflicts.
FRONTEND_PORT=18080
BACKEND_PORT=18000
FLOWER_PORT=15555
MYSQL_PORT=13306
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# Replace these before any shared or production deployment.
MYSQL_DATABASE=amazon_image_studio
MYSQL_USER=amazon
MYSQL_PASSWORD=local-amazon-password
MYSQL_ROOT_PASSWORD=local-root-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-password
S3_BUCKET=amazon-image-studio
# Leave blank for the bundled deployment: browsers use the authenticated
# same-origin asset content endpoint and never connect to MinIO directly.
S3_PUBLIC_ENDPOINT_URL=
ASSET_MAX_UPLOAD_BYTES=20971520
GENERATED_ASSET_MAX_BYTES=104857600
ASSET_MAX_IMAGE_PIXELS=40000000
ASSET_MAX_IMAGE_DIMENSION=12000
PROJECT_MAX_DRAFT_BYTES=1048576

# Phase 3 identity configuration. Replace every secret before shared use.
JWT_SECRET=local-development-jwt-secret-change-me
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_PASSWORD=local-admin-password
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ORGANIZATION_NAME=Default Organization
BOOTSTRAP_QUOTA_BALANCE=10000
API_KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RESOURCE_LEASE_TTL_SECONDS=900
RESOURCE_KEY_COOLDOWN_SECONDS=10
RESOURCE_KEY_COOLDOWN_MAX_SECONDS=10
PROVIDER_CONNECT_TIMEOUT_SECONDS=15
PROVIDER_REQUEST_TIMEOUT_SECONDS=480
PROVIDER_OUTPUT_MAX_BYTES=26214400
JOB_TIMEOUT_SECONDS=900
JOB_HEARTBEAT_TIMEOUT_SECONDS=180
JOB_DISPATCH_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
QUOTA_RESERVATION_TTL_MINUTES=60
